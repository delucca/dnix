# ── Font ─────────────────────────────────────────────────────
font-family = MonoLisaCode
font-size = 14
font-thicken = true
adjust-cell-height = 1

# ── Theme ────────────────────────────────────────────────────
theme = dark:TokyoNight Night,light:TokyoNight Day

# ── macOS ────────────────────────────────────────────────────
macos-titlebar-style = tabs
macos-option-as-alt = true

# mac-apps stamps the store path it copied, not what is in /Applications, so
# a Sparkle self-update would diverge silently and no switch would undo it.
# Upgrade through the flake lock instead.
auto-update = off

# ── Window ───────────────────────────────────────────────────
window-padding-x = 16
window-padding-y = 4
window-padding-balance = true
window-padding-color = background
window-save-state = always
window-inherit-working-directory = true
confirm-close-surface = false
resize-overlay = never

# ── Splits ───────────────────────────────────────────────────
# Create
keybind = super+d=new_split:right
keybind = super+shift+d=new_split:down

# Navigate (vim-style)
keybind = super+h=goto_split:left
keybind = super+j=goto_split:bottom
keybind = super+k=goto_split:top
keybind = super+l=goto_split:right

# Resize
keybind = super+alt+h=resize_split:left,10
keybind = super+alt+j=resize_split:down,10
keybind = super+alt+k=resize_split:up,10
keybind = super+alt+l=resize_split:right,10

# Zoom / equalize
keybind = super+shift+z=toggle_split_zoom
keybind = super+shift+equal=equalize_splits

# Visual
unfocused-split-opacity = 0.8

# ── Tabs ─────────────────────────────────────────────────────
keybind = super+shift+t=prompt_tab_title
keybind = super+shift+backslash=toggle_tab_overview

# ── Bell ─────────────────────────────────────────────────────
# A BEL marks the tab with 🔔 and bounces the dock until refocused. These are
# the 1.2+ defaults, pinned so an upstream change can't alter them.
bell-features = attention,title

# ── Shell ────────────────────────────────────────────────────
# Cmd+R → send Ctrl+R so it triggers the fzf history widget bound in zsh
keybind = super+r=text:\x12

# ── Quick Terminal (quake-style dropdown) ────────────────────
keybind = global:super+grave_accent=toggle_quick_terminal
quick-terminal-position = top
quick-terminal-animation-duration = 0.08
quick-terminal-autohide = true

# ── Shell Integration ────────────────────────────────────────
shell-integration = zsh
shell-integration-features = cursor,sudo,title,ssh-terminfo,ssh-env

# Prompt navigation in scrollback
keybind = super+up=jump_to_prompt:-1
keybind = super+down=jump_to_prompt:1

# ── Clipboard ────────────────────────────────────────────────
copy-on-select = clipboard
clipboard-read = ask
clipboard-write = allow
clipboard-paste-protection = true
clipboard-trim-trailing-spaces = true

# ── Scrollback ───────────────────────────────────────────────
scrollback-limit = 10000000

# ── Mouse ────────────────────────────────────────────────────
mouse-hide-while-typing = true

# ── Cursor ───────────────────────────────────────────────────
cursor-style = block
cursor-style-blink = false
